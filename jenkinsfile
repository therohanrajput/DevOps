pipeline {
    agent any

    environment {
        SF_INSTANCE_URL = 'https://login.salesforce.com'
    }

    stages {

        stage('Checkout Source') {
            steps {
                checkout scm
            }
        }

        stage('Verify CLI') {
            steps {
                sh 'sf --version'
            }
        }

        stage('Authenticate Salesforce (JWT)') {
            steps {
                withCredentials([
                    file(credentialsId: 'salesforce-jwt-key', variable: 'JWT_KEY'),
                    string(credentialsId: 'SF_CLIENT_ID', variable: 'CLIENT_ID'),
                    string(credentialsId: 'SF_USERNAME', variable: 'USERNAME')
                ]) {
                    sh '''
                    sf org login jwt \
                        --client-id $CLIENT_ID \
                        --jwt-key-file $JWT_KEY \
                        --username $USERNAME \
                        --instance-url $SF_INSTANCE_URL \
                        --set-default
                    '''
                }
            }
        }

        stage('Validate Deployment') {
            steps {
                sh 'sf project deploy start --dry-run --test-level NoTestRun'
            }
        }

        stage('Deploy to Org') {
            steps {
                sh 'sf project deploy start --test-level NoTestRun'
            }
        }
    }

    post {
        success {
            echo 'Deployment Successful ✅'
        }
        failure {
            echo 'Deployment Failed ❌'
        }
        always {
            cleanWs()
        }
    }
}
